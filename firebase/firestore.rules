rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /publishedContent/{slug} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['content', 'publishedAt'])
        && request.resource.data.content is map
        && request.resource.data.publishedAt == request.time;
      allow delete: if false;
    }

    match /siteContentDrafts/{slug} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['content', 'updatedAt'])
        && request.resource.data.content is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /siteRevisions/{revisionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['slug', 'content', 'publishedBy', 'createdAt'])
        && request.resource.data.slug == 'home'
        && request.resource.data.content is map
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    // 公開預約狀態：訪客只能讀取日期狀態，不能看到客人資料。
    match /availability/{dateId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'bookingId', 'updatedAt'])
        && request.resource.data.status in ['booked', 'blocked']
        && (request.resource.data.bookingId == null || request.resource.data.bookingId is string)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // 私人預約資料：姓名、電話、備註僅管理員可存取。
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['startDate','endDate','guestName','phone','people','deposit','notes','createdBy','createdAt','updatedAt'])
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.guestName is string
        && request.resource.data.phone is string
        && (request.resource.data.people == null || request.resource.data.people is int)
        && request.resource.data.deposit is string
        && request.resource.data.notes is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }


    // 圖片素材庫：只有管理員可以查看與管理素材索引；圖片本身由 Storage 提供。
    // 價格規則：僅管理員可讀寫；官網前台不直接公開。
    match /settings/pricing {
      // 後台價格設定：已登入且 admins/{uid} 存在才可讀寫。
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /imageLibrary/{assetId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['url','storagePath','fileName','category','size','contentType','createdBy','createdAt'])
        && request.resource.data.url is string
        && request.resource.data.storagePath is string
        && request.resource.data.fileName is string
        && request.resource.data.category is string
        && request.resource.data.size is int
        && request.resource.data.contentType is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
