# Vercel → Project Settings → Environment Variables (Production)
LINE_LOGIN_CHANNEL_ID=請貼上_俐姐的家_LINE_Login_Channel_ID
LINE_LOGIN_CHANNEL_SECRET=請貼上_俐姐的家_LINE_Login_Channel_Secret
BOOKING_SESSION_SECRET=請填至少64字元隨機密鑰
LINE_CHANNEL_SECRET=請貼上_俐姐的家_Messaging_API_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=請貼上_俐姐的家_Messaging_API_Channel_Access_Token
LINE_MINIAPP_CHANNEL_ID=2011502071


# Firestore 伺服器端預約儲存（Firebase Console → Project settings → Service accounts → Generate new private key）
# 將下載 JSON 整份壓成單行後貼入 Production；不要放進前端檔案或 GitHub。
FIREBASE_SERVICE_ACCOUNT_JSON=
# 也可不用 JSON，改填以下三個：
FIREBASE_PROJECT_ID=li-jie-s-home-official-website
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gmail API：只寄給客戶，不寄管理員。
# 建議用 Google OAuth refresh token，不要把 Gmail 密碼放進 Vercel。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=俐姐的家
