# Vercel → Project Settings → Environment Variables (Production)
BOOKING_SESSION_SECRET=請填至少64字元隨機密鑰
LINE_CHANNEL_SECRET=請貼上_俐姐的家_Messaging_API_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=請貼上_俐姐的家_Messaging_API_Channel_Access_Token


# Firestore 伺服器端預約儲存（Firebase Console → Project settings → Service accounts → Generate new private key）
# 將下載 JSON 整份壓成單行後貼入 Production；不要放進前端檔案或 GitHub。
FIREBASE_SERVICE_ACCOUNT_JSON=
# 也可不用 JSON，改填以下三個：
FIREBASE_PROJECT_ID=li-jie-s-home-official-website
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gmail API：寄客戶通知，也用同一個 Gmail API 寄新訂單通知給管理者。
# 建議用 Google OAuth refresh token，不要把 Gmail 密碼放進 Vercel。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=俐姐的家

# 新訂單管理者通知信箱；若留空會自動寄到 GMAIL_SENDER_EMAIL。
ADMIN_NOTIFICATION_EMAIL=
# 管理通知信「前往營運管理」按鈕使用；正式網域預設可留空。
PUBLIC_SITE_URL=https://www.5-1bbs.com

# 房務工作台授權帳號
HOUSEKEEPING_EMAIL=51bbsadmin@gmail.com

# 房務通知收件資料（兩欄一起設定；只用於寄信，不授予登入權限）
# 設定後後台唯讀顯示；不替換 ADMIN_NOTIFICATION_EMAIL 或新訂單第二收件者。
# 不會自動啟用提醒；排程、提醒時間與登入授權仍需各自確認。
HOUSEKEEPING_NOTIFICATION_CONTACT_NAME=
HOUSEKEEPING_NOTIFICATION_EMAIL=

# 已批准提醒時程的普通 Config JSON；不要把收件人或秘密放進這裡
HOUSEKEEPING_NOTIFICATION_TIMING=
# 只有專用 CRON_SECRET 與正式排程均驗證後才能 true；此範例保持停用
HOUSEKEEPING_NOTIFICATIONS_ENABLED=false
HOUSEKEEPING_NOTIFICATION_ACTIVATION_ID=
# 只在 lijie-home Production 建立三個每日 Vercel Cron；預設關閉
HOUSEKEEPING_REMINDER_CRON_ENABLED=false
# 使用 Vercel 的 Sensitive 欄位安全配置專用亂數秘密，不貼到聊天或 Git
CRON_SECRET=
# 必須核對 Cron 已建立且授權端點正常後才設為 true
HOUSEKEEPING_REMINDER_SCHEDULE_READY=false
